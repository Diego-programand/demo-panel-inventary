# ========================================================
# ARCHIVO DE EJEMPLO DE VARIABLES DE ENTORNO (.env.example)
# ========================================================
# Copia este archivo a '.env.local' para desarrollo local.
# NUNCA agregues claves privadas o secretos reales a este archivo.

# Entorno de la aplicación
NODE_ENV=development
NEXT_PUBLIC_APP_NAME="DemoPanel Inventory OS"
NEXT_PUBLIC_APP_VERSION="1.0.0"

# Nicho por defecto ('retail_fashion', 'pharma_health', 'tech_electronics', 'food_beverage')
NEXT_PUBLIC_DEFAULT_NICHE="retail_fashion"

# Integraciones opcionales futuras (dejar vacías en desarrollo)
# NEXT_PUBLIC_ANALYTICS_ID=
